<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup or device transfer: secrets are sealed under an
     Android Keystore key that never leaves this device, so a copy elsewhere could
     never be opened (and would lock its profiles). Orbit's own Backup moves data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
